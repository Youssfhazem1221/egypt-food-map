// Cloudflare Pages config: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
// The site is the Pages project "rkhees" → https://rkhees.pages.dev
// Static files: public/ · API: functions/api/[[route]].js → src/worker.js
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rkhees",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "egypt-food-map",
      "database_id": "03461b59-ded7-49fc-bab5-b094b28dbb60"
    }
  ]
}
